# Node dependencies and build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# SQLite Database instances (re-created dynamically from schema.sql)
*.db
*.sqlite
*.sqlite3
backend/database/*.db

# Uploaded documents (preserve folder with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
